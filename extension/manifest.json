{
  "manifest_version": 3,
  "name": "Gate Keepa",
  "version": "0.2.3",
  "description": "Local-first Keepa/Amazon sourcing overlays with seller-specific listing eligibility.",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://keepa.com/*",
    "https://*.keepa.com/*",
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.ca/*"
  ],
  "background": {
    "scripts": [
      "lib/common.js",
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gate Keepa",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "sourcing-cockpit@marcmy.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://keepa.com/*",
        "https://*.keepa.com/*"
      ],
      "js": [
        "lib/common.js",
        "content/keepa.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.ca/*"
      ],
      "js": [
        "lib/common.js",
        "content/amazon.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
